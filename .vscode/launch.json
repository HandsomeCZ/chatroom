{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试聊天室 (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/chatroom",
            "args": ["--port", "8080"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "编译聊天室"
        }
    ]
}
